    {
      "name": "6. RBAC & Edge Cases",
      "item": [
        {
          "name": "Customer Blocked from Creating Product (403 Forbidden)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"UNAUTH-01\",\n  \"title\": \"Unauthorized Item\",\n  \"description\": \"Testing RBAC denial\",\n  \"price\": 100,\n  \"stockQuantity\": 5,\n  \"categoryId\": \"cat_home\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["products"]
