{
  "info": {
    "_postman_id": "e7192a01-5231-419b-b481-8b2091829102",
    "name": "BharatMart E-Commerce & Inventory API",
    "description": "Comprehensive Postman v2.1 collection for testing the BharatMart E-Commerce & Inventory Management REST API (ShadowFox Intermediate Level). Includes automated assertions for JWT authentication, role-based access control (RBAC), stock validation, and atomic checkout transactions.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5002/api/v1",
      "type": "string"
    },
    {
      "key": "customerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "productId",
      "value": "prod_boat_450",
